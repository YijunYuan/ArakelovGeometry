module

public import Mathlib.Basic.Real.Basic
public import Mathlib.LinearAlgebra.FiniteDimensional.Defs
import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas

/-!
# Largest maximizing subspaces for a supermodular degree

The finite-dimensional subspace lattice has a largest nonzero subspace
maximizing a supermodular degree divided by a positive modular rank.
Source Proposition 4.3.28 requires no boundedness or continuity hypothesis.
-/

@[expose] public section

namespace ArakelovGeometry

universe u w

variable {K : Type u} [Field K] {V : Type w} [AddCommGroup V] [Module K V]

/-- A modular rank, zero at the zero subspace and positive elsewhere,
strictly increases along proper inclusions. A relative complement proves
this without a normalization or proportionality premise. -/
theorem modular_submodule_rank_strictMono (r : Submodule K V → ℝ)
    (hzero : r ⊥ = 0) (hpos : ∀ U, U ≠ ⊥ → 0 < r U)
    (hmod : ∀ U W, r (U ⊓ W) + r (U ⊔ W) = r U + r W) : StrictMono r := by
  intro U P hUP
  obtain ⟨T, hT⟩ := U.exists_isCompl
  have hinf : U ⊓ (T ⊓ P) = ⊥ := by
    rw [← inf_assoc, hT.inf_eq_bot, bot_inf_eq]
  have hsup : U ⊔ (T ⊓ P) = P := by
    rw [← sup_inf_assoc_of_le T hUP.le, hT.sup_eq_top, top_inf_eq]
  have hn : T ⊓ P ≠ ⊥ := by
    intro hz
    rw [hz, sup_bot_eq] at hsup
    exact hUP.ne hsup
  have hm := hmod U (T ⊓ P)
  rw [hinf, hsup, hzero] at hm
  have hp := hpos (T ⊓ P) hn
  linarith

/-- A modular rank has the same value on all nonzero lines. The third
line generated by `x + y` compares two distinct lines; subtraction gives
the plane identities in every characteristic, including characteristic two. -/
theorem modular_submodule_rank_span_singleton_eq (r : Submodule K V → ℝ)
    (hrzero : r ⊥ = 0)
    (hrmod : ∀ U W, r (U ⊓ W) + r (U ⊔ W) = r U + r W)
    (x y : V) (hx : x ≠ 0) (hy : y ≠ 0) : r (K ∙ x) = r (K ∙ y) := by
  let L := K ∙ x
  let M := K ∙ y
  by_cases hLM : L = M
  · exact congrArg r hLM
  have hL : IsAtom L := Submodule.isAtom_iff_finrank_eq_one.mpr (finrank_span_singleton hx)
  have hM : IsAtom M := Submodule.isAtom_iff_finrank_eq_one.mpr (finrank_span_singleton hy)
  have hxL : x ∈ L := Submodule.mem_span_singleton_self x
  have hyM : y ∈ M := Submodule.mem_span_singleton_self y
  have hyL : y ∉ L := by
    intro h
    have he := (hL.le_iff_eq hM.ne_bot).mp
      ((Submodule.span_singleton_le_iff_mem y L).mpr h)
    exact hLM he.symm
  have hxM : x ∉ M := by
    intro h
    have he := (hM.le_iff_eq hL.ne_bot).mp
      ((Submodule.span_singleton_le_iff_mem x M).mpr h)
    exact hLM he
  have hxyL : x + y ∉ L := by
    intro h
    exact hyL (by simpa only [add_sub_cancel_left] using L.sub_mem h hxL)
  have hxyM : x + y ∉ M := by
    intro h
    exact hxM (by simpa only [add_sub_cancel_right] using M.sub_mem h hyM)
  have hxy : x + y ≠ 0 := fun h ↦ hxyL (h ▸ L.zero_mem)
  let N := K ∙ (x + y)
  have hN : IsAtom N :=
    Submodule.isAtom_iff_finrank_eq_one.mpr (finrank_span_singleton hxy)
  have hxyN : x + y ∈ N := Submodule.mem_span_singleton_self (x + y)
  have hLN : L ≠ N := fun h ↦ hxyL (h ▸ hxyN)
  have hMN : M ≠ N := fun h ↦ hxyM (h ▸ hxyN)
  have hNle : N ≤ L ⊔ M := (Submodule.span_singleton_le_iff_mem _ _).mpr
    ((L ⊔ M).add_mem (Submodule.mem_sup_left hxL) (Submodule.mem_sup_right hyM))
  have hLNsup : L ⊔ N = L ⊔ M := by
    apply le_antisymm (sup_le le_sup_left hNle)
    apply sup_le le_sup_left
    apply (Submodule.span_singleton_le_iff_mem y _).mpr
    simpa only [add_sub_cancel_left] using
      (L ⊔ N).sub_mem (Submodule.mem_sup_right hxyN) (Submodule.mem_sup_left hxL)
  have hMNsup : M ⊔ N = L ⊔ M := by
    apply le_antisymm (sup_le le_sup_right hNle)
    apply sup_le _ le_sup_left
    apply (Submodule.span_singleton_le_iff_mem x _).mpr
    simpa only [add_sub_cancel_right] using
      (M ⊔ N).sub_mem (Submodule.mem_sup_right hxyN) (Submodule.mem_sup_left hyM)
  have h₁ := hrmod L N
  have h₂ := hrmod M N
  rw [(hL.disjoint_of_ne hN hLN).eq_bot, hLNsup, hrzero] at h₁
  rw [(hM.disjoint_of_ne hN hMN).eq_bot, hMNsup, hrzero] at h₂
  change r L = r M
  linarith

variable [FiniteDimensional K V]

/-- A modular rank on a finite-dimensional subspace lattice equals
dimension times its value on any fixed nonzero line. This is the source's
rank-normalization bridge; the line comparison is valid in every characteristic. -/
theorem modular_submodule_rank_eq_span_mul_finrank (r : Submodule K V → ℝ)
    (hrzero : r ⊥ = 0)
    (hrmod : ∀ U W, r (U ⊓ W) + r (U ⊔ W) = r U + r W)
    (x₀ : V) (hx₀ : x₀ ≠ 0) (U : Submodule K V) :
    r U = r (K ∙ x₀) * (Module.finrank K U : ℝ) := by
  suffices h : ∀ n (U : Submodule K V), Module.finrank K U = n →
      r U = r (K ∙ x₀) * (Module.finrank K U : ℝ) by
    exact h (Module.finrank K U) U rfl
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
    intro U hUn
    by_cases hU : U = ⊥
    · rw [Submodule.finrank_eq_zero.mpr hU, Nat.cast_zero, mul_zero, hU, hrzero]
    · obtain ⟨x, hxU, hx⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hU
      let L := K ∙ x
      have hL : IsAtom L :=
        Submodule.isAtom_iff_finrank_eq_one.mpr (finrank_span_singleton hx)
      have hLU : L ≤ U := (Submodule.span_singleton_le_iff_mem x U).mpr hxU
      obtain ⟨T, hT⟩ := L.exists_isCompl
      let R := T ⊓ U
      have hinf : L ⊓ R = ⊥ := by
        rw [← inf_assoc, hT.inf_eq_bot, bot_inf_eq]
      have hsup : L ⊔ R = U := by
        rw [← sup_inf_assoc_of_le T hLU, hT.sup_eq_top, top_inf_eq]
      have hRU : R < U := lt_of_le_of_ne inf_le_right (by
        intro he
        rw [he, inf_eq_left.mpr hLU] at hinf
        exact hL.ne_bot hinf)
      have hRn : Module.finrank K R < n := by
        rw [← hUn]
        exact Submodule.finrank_lt_finrank_of_lt hRU
      have hR := ih (Module.finrank K R) hRn R rfl
      have hm := hrmod L R
      rw [hinf, hsup, hrzero, zero_add,
        modular_submodule_rank_span_singleton_eq r hrzero hrmod x x₀ hx hx₀, hR] at hm
      have hn := Submodule.finrank_sup_add_finrank_inf_eq L R
      rw [hsup, hinf, finrank_bot, finrank_span_singleton hx, Nat.add_zero] at hn
      have hnR : (Module.finrank K U : ℝ) = 1 + (Module.finrank K R : ℝ) := by
        exact_mod_cast hn
      rw [hnR, mul_add, mul_one]
      exact hm

/-- The source modular positive rank is a positive constant times the
ordinary dimension. This follows from actual line comparison and successive
relative complements, rather than assuming a dimension formula for the rank. -/
theorem exists_pos_modular_submodule_rank_eq_mul_finrank [Nontrivial V]
    (r : Submodule K V → ℝ) (hrzero : r ⊥ = 0)
    (hrpos : ∀ U, U ≠ ⊥ → 0 < r U)
    (hrmod : ∀ U W, r (U ⊓ W) + r (U ⊔ W) = r U + r W) :
    ∃ c : ℝ, 0 < c ∧ ∀ U : Submodule K V, r U = c * (Module.finrank K U : ℝ) := by
  obtain ⟨x₀, hx₀⟩ := exists_ne (0 : V)
  have hL : IsAtom (K ∙ x₀) :=
    Submodule.isAtom_iff_finrank_eq_one.mpr (finrank_span_singleton hx₀)
  exact ⟨r (K ∙ x₀), hrpos _ hL.ne_bot,
    modular_submodule_rank_eq_span_mul_finrank r hrzero hrmod x₀ hx₀⟩

/-- On every nonzero interval of the actual subspace lattice, a positive
modular rank and a supermodular degree admit a largest slope maximizer.
The induction chooses a largest-dimensional subspace above the ambient
slope; it never assumes that the slopes are bounded or attained. -/
theorem exists_largest_supermodular_slope_maximizer_le
    (r d : Submodule K V → ℝ)
    (hrzero : r ⊥ = 0) (hrpos : ∀ U, U ≠ ⊥ → 0 < r U)
    (hrmod : ∀ U W, r (U ⊓ W) + r (U ⊔ W) = r U + r W)
    (hdzero : d ⊥ ≤ 0) (hdsuper : ∀ U W, d U + d W ≤ d (U ⊓ W) + d (U ⊔ W))
    (P : Submodule K V) (hP : P ≠ ⊥) :
    ∃ D : Submodule K V, D ≤ P ∧ D ≠ ⊥ ∧
      ∀ F : Submodule K V, F ≤ P → F ≠ ⊥ →
        d F / r F ≤ d D / r D ∧ (d F / r F = d D / r D → F ≤ D) := by
  classical
  let μ := fun F : Submodule K V ↦ d F / r F
  have hmono := modular_submodule_rank_strictMono r hrzero hrpos hrmod
  suffices h : ∀ n (P : Submodule K V), Module.finrank K P = n → P ≠ ⊥ →
      ∃ D : Submodule K V, D ≤ P ∧ D ≠ ⊥ ∧
        ∀ F : Submodule K V, F ≤ P → F ≠ ⊥ →
          μ F ≤ μ D ∧ (μ F = μ D → F ≤ D) by
    exact h (Module.finrank K P) P rfl hP
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
    intro P hPn hP
    by_cases hall : ∀ F : Submodule K V, F ≤ P → F ≠ ⊥ → μ F ≤ μ P
    · exact ⟨P, le_rfl, hP, fun F hFP hF ↦ ⟨hall F hFP hF, fun _ ↦ hFP⟩⟩
    · push Not at hall
      obtain ⟨U₀, hU₀P, hU₀, hμ₀⟩ := hall
      let q := fun k : ℕ ↦ ∃ U : Submodule K V,
        U ≤ P ∧ U ≠ ⊥ ∧ μ P < μ U ∧ Module.finrank K U = k
      have hq : q (Nat.findGreatest q (Module.finrank K P)) :=
        Nat.findGreatest_spec (Submodule.finrank_mono hU₀P)
          ⟨U₀, hU₀P, hU₀, hμ₀, rfl⟩
      obtain ⟨U, hUP, hU, hμU, hUr⟩ := hq
      have hUPstrict : U < P := lt_of_le_of_ne hUP (by
        intro he
        rw [he] at hμU
        exact lt_irrefl _ hμU)
      have hUrn : Module.finrank K U < n := by
        rw [← hPn]
        exact Submodule.finrank_lt_finrank_of_lt hUPstrict
      obtain ⟨D, hDU, hD, hDmax⟩ := ih (Module.finrank K U) hUrn U rfl hU
      have hμUD : μ U ≤ μ D := (hDmax U le_rfl hU).1
      refine ⟨D, hDU.trans hUP, hD, fun F hFP hF ↦ ?_⟩
      by_cases hFU : F ≤ U
      · exact hDmax F hFU hF
      · let I := F ⊓ U
        let T := F ⊔ U
        have hUT : U < T := lt_of_le_of_ne le_sup_right (by
          intro he
          apply hFU
          exact (le_sup_left : F ≤ T).trans_eq he.symm)
        have hTP : T ≤ P := sup_le hFP hUP
        have hμT : μ T ≤ μ P := by
          by_contra hn
          have hgood : q (Module.finrank K T) :=
            ⟨T, hTP, ne_bot_of_gt hUT, lt_of_not_ge hn, rfl⟩
          have hmax := Nat.le_findGreatest (Submodule.finrank_mono hTP) hgood
          rw [← hUr] at hmax
          exact not_le_of_gt (Submodule.finrank_lt_finrank_of_lt hUT) hmax
        have hI : d I ≤ μ D * r I := by
          by_cases hz : I = ⊥
          · simpa only [hz, hrzero, mul_zero] using hdzero
          · exact (div_le_iff₀ (hrpos I hz)).mp (hDmax I inf_le_right hz).1
        have hTr : 0 < r T := (hrpos U hU).trans (hmono hUT)
        have hT : d T < μ U * r T :=
          (div_lt_iff₀ hTr).mp (hμT.trans_lt hμU)
        have hIF : I < F := lt_of_le_of_ne inf_le_left (by
          intro he
          apply hFU
          rw [← he]
          exact inf_le_right)
        have hstep : μ U * (r F - r I) ≤ μ D * (r F - r I) :=
          mul_le_mul_of_nonneg_right hμUD (sub_nonneg.mpr (hmono hIF).le)
        have hUeq : d U = μ U * r U := by
          dsimp only [μ]
          rw [div_mul_cancel₀ _ (hrpos U hU).ne']
        have hmodU := congrArg (fun x : ℝ ↦ μ U * x) (hrmod F U)
        have hsuper := hdsuper F U
        have hFdeg : d F < μ D * r F := by
          change d F + d U ≤ d I + d T at hsuper
          change μ U * (r I + r T) = μ U * (r F + r U) at hmodU
          nlinarith
        have hFslope : μ F < μ D := (div_lt_iff₀ (hrpos F hF)).mpr hFdeg
        exact ⟨hFslope.le, fun he ↦ False.elim (hFslope.ne he)⟩

/-- Source Proposition 4.3.28: there is a unique largest maximizing
nonzero subspace, for arbitrary actual real-valued modular rank and
supermodular degree. Its real slope is the attained finite maximum. -/
theorem exists_unique_largest_supermodular_slope_maximizer [Nontrivial V]
    (r d : Submodule K V → ℝ)
    (hrzero : r ⊥ = 0) (hrpos : ∀ U, U ≠ ⊥ → 0 < r U)
    (hrmod : ∀ U W, r (U ⊓ W) + r (U ⊔ W) = r U + r W)
    (hdzero : d ⊥ ≤ 0) (hdsuper : ∀ U W, d U + d W ≤ d (U ⊓ W) + d (U ⊔ W)) :
    ∃! D : Submodule K V, D ≠ ⊥ ∧
      ∀ F : Submodule K V, F ≠ ⊥ →
        d F / r F ≤ d D / r D ∧ (d F / r F = d D / r D → F ≤ D) := by
  obtain ⟨D, _, hD, hmax⟩ := exists_largest_supermodular_slope_maximizer_le
    r d hrzero hrpos hrmod hdzero hdsuper ⊤ top_ne_bot
  refine ⟨D, ⟨hD, fun F hF ↦ hmax F le_top hF⟩, ?_⟩
  rintro D' ⟨hD', hmax'⟩
  have he : d D' / r D' = d D / r D :=
    le_antisymm (hmax D' le_top hD').1 (hmax' D hD).1
  exact le_antisymm ((hmax D' le_top hD').2 he) ((hmax' D hD).2 he.symm)

/-- The ordinary dimension-rank specialization used by actual adelic
degrees. Only degree supermodularity and its value at zero are hypotheses. -/
theorem exists_unique_largest_finrank_slope_maximizer [Nontrivial V]
    (d : Submodule K V → ℝ) (hdzero : d ⊥ ≤ 0)
    (hdsuper : ∀ U W, d U + d W ≤ d (U ⊓ W) + d (U ⊔ W)) :
    ∃! D : Submodule K V, D ≠ ⊥ ∧
      ∀ F : Submodule K V, F ≠ ⊥ →
        d F / (Module.finrank K F : ℝ) ≤ d D / (Module.finrank K D : ℝ) ∧
          (d F / (Module.finrank K F : ℝ) = d D / (Module.finrank K D : ℝ) → F ≤ D) := by
  apply exists_unique_largest_supermodular_slope_maximizer
    (fun F ↦ (Module.finrank K F : ℝ)) d _ _ _ hdzero hdsuper
  · simp only [finrank_bot, Nat.cast_zero]
  · intro F hF
    exact Nat.cast_pos.mpr (Nat.pos_of_ne_zero (fun hz ↦ hF (Submodule.finrank_eq_zero.mp hz)))
  · intro F G
    have h := Submodule.finrank_sup_add_finrank_inf_eq F G
    simpa only [Nat.cast_add, add_comm] using congrArg (fun n : ℕ ↦ (n : ℝ)) h

end ArakelovGeometry
