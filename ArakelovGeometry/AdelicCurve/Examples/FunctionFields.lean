/-!
# The function-field adelic curve (Chen–Moriwaki §3.2.1)

Chen–Moriwaki §3.2.1 attaches a proper adelic curve to the field of rational functions of any
regular projective curve `C` over a field `k`: the index set is the set of closed points of
`C`, a closed point `x` carries the absolute value `e^{-ord_x}` and the weight
`n_x = [κ(x) : k]`, and properness is the vanishing of the degree of principal divisors.

This file formalizes the fundamental case `C = ℙ¹_k`, whose function field is `RatFunc k`.
The general case is a finite extension of this one and will be obtained from the
scalar-extension machinery of §3.3–3.4.  The closed points of `ℙ¹_k` are the closed points of
`𝔸¹_k` — i.e. the height-one primes of `k[X]` — together with the point at infinity, so we
take `Ω := Option (IsDedekindDomain.HeightOneSpectrum (Polynomial k))` with the discrete
σ-algebra.  A finite point `v` carries the absolute value `e^{-ord_v}` (mathlib's
`IsDedekindDomain.HeightOneSpectrum.adicAbv` with base `e`) and the weight
`n_v = [κ(v) : k]`, the degree of a generator of `v`; the point at infinity carries `e^{deg}`
(built from `RatFunc.inftyValuation`) and the weight `1`.  Properness is the product formula
`∑_x n_x ord_x (f) = 0`, proved by multiplicativity and induction on prime factorizations.

Since `Ω` is uncountable whenever `k` is, integrability against the point-mass measure is
established through the finite-support criteria of `ArakelovGeometry.ExternalResults.Measure`
rather than through countable sums of Dirac measures.
-/

@[expose] public section

namespace ArakelovGeometry.AdelicStructure

open MeasureTheory AbsoluteValue IsDedekindDomain IsDedekindDomain.HeightOneSpectrum WithZero
  WithZeroMulInt
open scoped ENNReal NNReal

/-! ### The exponential base -/

section ExpBase

/-- Euler's number `e` as an element of `ℝ≥0`: the base of all the absolute values of the
function-field adelic curve, following Chen–Moriwaki §3.2.1. -/
noncomputable def expBase : ℝ≥0 := (Real.exp 1).toNNReal

theorem one_lt_expBase : (1 : ℝ≥0) < expBase := by
  rw [expBase, ← Real.toNNReal_one]
  exact (Real.toNNReal_lt_toNNReal_iff (Real.exp_pos 1)).mpr
    (Real.one_lt_exp_iff.mpr one_pos)

theorem coe_expBase : (expBase : ℝ) = Real.exp 1 :=
  Real.coe_toNNReal _ (Real.exp_pos 1).le

/-- `WithZeroMulInt.toNNReal expBase` intertwines `WithZero.log` and the real logarithm. -/
theorem real_log_toNNReal_expBase {x : ℤᵐ⁰} (hx : x ≠ 0) :
    Real.log (toNNReal (ne_zero_of_lt one_lt_expBase) x : ℝ) = WithZero.log x := by
  rw [toNNReal_neg_apply _ hx, NNReal.coe_zpow, Real.log_zpow,
    coe_expBase, Real.log_exp, mul_one]

end ExpBase

/-! ### Finite places -/

section FinitePlaces

variable {k : Type*} [Field k]

/-- The degree `n_v = [κ(v) : k]` of a closed point `v` of `𝔸¹_k`, computed as the degree of
a generator of the corresponding maximal ideal of `k[X]`. -/
noncomputable def pointDegree (v : HeightOneSpectrum (Polynomial k)) : ℕ :=
  (Submodule.IsPrincipal.generator v.asIdeal).natDegree

/-- The degree of the point cut out by a polynomial `q` is the degree of `q`. -/
theorem pointDegree_eq_of_span {q : Polynomial k}
    {v : HeightOneSpectrum (Polynomial k)} (hv : v.asIdeal = Ideal.span {q}) :
    pointDegree v = q.natDegree := by
  obtain ⟨u, hu⟩ : Associated (Submodule.IsPrincipal.generator v.asIdeal) q := by
    rw [← Ideal.span_singleton_eq_span_singleton, Ideal.span_singleton_generator, hv]
  have hgen : Submodule.IsPrincipal.generator v.asIdeal ≠ 0 := by
    intro h0
    exact v.ne_bot (by rw [← Ideal.span_singleton_generator v.asIdeal, h0,
      Ideal.span_singleton_eq_bot])
  rw [pointDegree, ← hu, Polynomial.natDegree_mul hgen u.ne_zero,
    Polynomial.natDegree_eq_zero_of_isUnit u.isUnit, add_zero]

/-- The height-one prime of `k[X]` generated by a prime polynomial. -/
noncomputable def spanPrime {q : Polynomial k} (hq : Prime q) :
    HeightOneSpectrum (Polynomial k) where
  asIdeal := Ideal.span {q}
  isPrime := (Ideal.span_singleton_prime hq.ne_zero).mpr hq
  ne_bot := by simpa [Ideal.span_singleton_eq_bot] using hq.ne_zero

@[simp]
theorem spanPrime_asIdeal {q : Polynomial k} (hq : Prime q) :
    (spanPrime hq).asIdeal = Ideal.span {q} := rfl

/-- The degree of the point cut out by a prime polynomial `q` is the degree of `q`. -/
theorem pointDegree_spanPrime {q : Polynomial k} (hq : Prime q) :
    pointDegree (spanPrime hq) = q.natDegree :=
  pointDegree_eq_of_span rfl

/-- The real logarithm of the `v`-adic absolute value with base `e` is `WithZero.log` of the
`v`-adic valuation. -/
theorem real_log_adicAbv (v : HeightOneSpectrum (Polynomial k)) {f : RatFunc k} (hf : f ≠ 0) :
    Real.log (v.adicAbv one_lt_expBase f) =
      WithZero.log (v.valuation (RatFunc k) f) :=
  real_log_toNNReal_expBase ((Valuation.ne_zero_iff _).mpr hf)

/-- The valuation of a prime polynomial at its own point is `exp (-1)`. -/
theorem valuation_spanPrime_self {q : Polynomial k} (hq : Prime q) :
    (spanPrime hq).valuation (RatFunc k) (algebraMap (Polynomial k) (RatFunc k) q) =
      exp (-1 : ℤ) := by
  rw [valuation_of_algebraMap]
  exact intValuation_singleton _ hq.ne_zero rfl

/-- The valuation of a prime polynomial at any other point is `1`. -/
theorem valuation_algebraMap_eq_one_of_ne {q : Polynomial k} (hq : Prime q)
    {v : HeightOneSpectrum (Polynomial k)} (hv : v ≠ spanPrime hq) :
    v.valuation (RatFunc k) (algebraMap (Polynomial k) (RatFunc k) q) = 1 := by
  rw [valuation_of_algebraMap, intValuation_eq_one_iff]
  intro hmem
  refine hv (HeightOneSpectrum.ext ?_)
  have hmax : (Ideal.span {q} : Ideal (Polynomial k)).IsMaximal :=
    Ideal.IsPrime.isMaximal ((Ideal.span_singleton_prime hq.ne_zero).mpr hq)
      (by simpa [Ideal.span_singleton_eq_bot] using hq.ne_zero)
  exact (hmax.eq_of_le v.isPrime.ne_top
    (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hmem))).symm.trans
    (spanPrime_asIdeal hq).symm

/-- The valuation of a nonzero constant at any finite point is `1`. -/
theorem valuation_algebraMap_C (v : HeightOneSpectrum (Polynomial k)) {c : k} (hc : c ≠ 0) :
    v.valuation (RatFunc k) (algebraMap (Polynomial k) (RatFunc k) (Polynomial.C c)) = 1 := by
  rw [valuation_of_algebraMap, intValuation_eq_one_iff]
  intro hmem
  exact v.isPrime.ne_top
    (Ideal.eq_top_of_isUnit_mem _ hmem (Polynomial.isUnit_C.mpr hc.isUnit))

end FinitePlaces

/-! ### The place at infinity -/

section InftyPlace

variable {k : Type*} [Field k]

open Classical in
/-- The absolute value at infinity on `k(X)`, as a map to `ℝ≥0`: the base-`e` version of
`RatFunc.inftyValuation`, sending a nonzero `f` to `e^{deg f}`. -/
noncomputable def inftyAbvDef (f : RatFunc k) : ℝ≥0 :=
  toNNReal (ne_zero_of_lt one_lt_expBase) (RatFunc.inftyValuation k f)

open Classical in
theorem isNonarchimedean_inftyAbvDef : IsNonarchimedean (inftyAbvDef (k := k)) := by
  intro x y
  simp only [inftyAbvDef]
  have h_mono := (toNNReal_strictMono one_lt_expBase).monotone
  rw [← h_mono.map_max]
  exact h_mono ((RatFunc.inftyValuation k).map_add x y)

open Classical in
/-- The absolute value at infinity on `k(X)`, sending a nonzero `f` to `e^{deg f}`
(Chen–Moriwaki §3.2.1 for the point at infinity of `ℙ¹_k`). -/
noncomputable def inftyAbv (k : Type*) [Field k] : AbsoluteValue (RatFunc k) ℝ where
  toFun f := inftyAbvDef f
  map_mul' _ _ := by simp [inftyAbvDef]
  nonneg' _ := NNReal.zero_le_coe
  eq_zero' _ := by simp [inftyAbvDef]
  add_le' _ _ := isNonarchimedean_inftyAbvDef.add_le fun _ ↦ NNReal.zero_le_coe

/-- The real logarithm of the absolute value at infinity of a nonzero polynomial is its
degree. -/
theorem real_log_inftyAbv_algebraMap {p : Polynomial k} (hp : p ≠ 0) :
    Real.log (inftyAbv k (algebraMap (Polynomial k) (RatFunc k) p)) = p.natDegree := by
  classical
  have hne : RatFunc.inftyValuation k (algebraMap (Polynomial k) (RatFunc k) p) ≠ 0 := by
    rw [Valuation.ne_zero_iff]
    exact RatFunc.algebraMap_ne_zero hp
  rw [show inftyAbv k (algebraMap (Polynomial k) (RatFunc k) p)
      = (inftyAbvDef (algebraMap (Polynomial k) (RatFunc k) p) : ℝ) from rfl, inftyAbvDef,
    real_log_toNNReal_expBase hne, RatFunc.inftyValuation_apply,
    RatFunc.inftyValuation.polynomial k hp, log_exp, Int.cast_natCast]

end InftyPlace

/-! ### Closed points of `ℙ¹` and the product formula -/

section Points

variable {k : Type*} [Field k]

/-- The absolute value attached to a closed point of `ℙ¹_k`: the `v`-adic one at a finite
point `v`, the degree one at infinity. -/
noncomputable def pointAbv (k : Type*) [Field k] :
    Option (HeightOneSpectrum (Polynomial k)) → AbsoluteValue (RatFunc k) ℝ
  | none => inftyAbv k
  | some v => v.adicAbv one_lt_expBase

/-- The weight `n_x = [κ(x) : k]` of a closed point of `ℙ¹_k`, as a measure of the
singleton `{x}`: the residue degree at a finite point, `1` at infinity. -/
noncomputable def pointWeight (k : Type*) [Field k] :
    Option (HeightOneSpectrum (Polynomial k)) → ℝ≥0∞
  | none => 1
  | some v => pointDegree v

@[simp]
theorem pointAbv_none : pointAbv k none = inftyAbv k := rfl

@[simp]
theorem pointAbv_some (v : HeightOneSpectrum (Polynomial k)) :
    pointAbv k (some v) = v.adicAbv one_lt_expBase := rfl

@[simp]
theorem pointWeight_none : pointWeight k none = 1 := rfl

@[simp]
theorem pointWeight_some (v : HeightOneSpectrum (Polynomial k)) :
    pointWeight k (some v) = pointDegree v := rfl

theorem pointWeight_ne_top (ω : Option (HeightOneSpectrum (Polynomial k))) :
    pointWeight k ω ≠ ∞ := by
  cases ω with
  | none => exact ENNReal.one_ne_top
  | some v => exact ENNReal.natCast_ne_top _

/-- Clearing denominators in `RatFunc`. -/
theorem algebraMap_num_eq_mul_denom (f : RatFunc k) :
    algebraMap (Polynomial k) (RatFunc k) f.num
      = f * algebraMap (Polynomial k) (RatFunc k) f.denom :=
  (div_eq_iff (RatFunc.algebraMap_ne_zero f.denom_ne_zero)).mp (RatFunc.num_div_denom f)

/-- The `v`-adic valuation of `r` is `1` when `v` does not divide `(r)`. -/
theorem intValuation_eq_one_of_not_dvd {r : Polynomial k}
    {v : HeightOneSpectrum (Polynomial k)} (h : ¬v.asIdeal ∣ Ideal.span {r}) :
    v.intValuation r = 1 :=
  le_antisymm (v.intValuation_le_one r)
    (not_lt.mp fun hlt ↦ h ((intValuation_lt_one_iff_dvd _ _).mp hlt))

/-- The `v`-adic valuation of `f` is `1` when `v` divides neither the numerator nor the
denominator of `f`. -/
theorem valuation_eq_one_of_intValuation_num_denom {f : RatFunc k}
    {v : HeightOneSpectrum (Polynomial k)}
    (hnum : v.intValuation f.num = 1) (hden : v.intValuation f.denom = 1) :
    v.valuation (RatFunc k) f = 1 := by
  have key := congrArg (v.valuation (RatFunc k)) (algebraMap_num_eq_mul_denom f)
  rw [map_mul, valuation_of_algebraMap, valuation_of_algebraMap, hnum, hden, mul_one] at key
  exact key.symm

/-- The logarithmic integrand of `f` is supported in the prime factors of the numerator and
the denominator of `f`, together with the point at infinity. -/
theorem support_log_pointAbv_subset (f : RatFunc k) :
    (Function.support fun ω ↦ Real.log (pointAbv k ω f)) ⊆
      insert none (some '' ({v : HeightOneSpectrum (Polynomial k) |
        v.asIdeal ∣ Ideal.span {f.num}} ∪
          {v : HeightOneSpectrum (Polynomial k) | v.asIdeal ∣ Ideal.span {f.denom}})) := by
  rintro (_ | v) hω
  · exact Set.mem_insert _ _
  · refine Set.mem_insert_of_mem _ ⟨v, ?_, rfl⟩
    by_contra hv
    rw [Set.mem_union, not_or] at hv
    simp only [Function.mem_support] at hω
    by_cases hf : f = 0
    · exact hω (by simp [hf])
    · exact hω (by rw [pointAbv_some, real_log_adicAbv v hf,
        valuation_eq_one_of_intValuation_num_denom
          (intValuation_eq_one_of_not_dvd hv.1) (intValuation_eq_one_of_not_dvd hv.2),
        log_one, Int.cast_zero])

/-- For nonzero `f`, the logarithmic integrand of `f` has finite support. -/
theorem finite_support_log {f : RatFunc k} (hf : f ≠ 0) :
    (Function.support fun ω ↦ Real.log (pointAbv k ω f)).Finite := by
  have hnum : (Ideal.span {f.num} : Ideal (Polynomial k)) ≠ 0 := by
    rw [Ne, Ideal.zero_eq_bot, Ideal.span_singleton_eq_bot]
    exact RatFunc.num_ne_zero hf
  have hden : (Ideal.span {f.denom} : Ideal (Polynomial k)) ≠ 0 := by
    rw [Ne, Ideal.zero_eq_bot, Ideal.span_singleton_eq_bot]
    exact f.denom_ne_zero
  exact Set.Finite.subset (Set.Finite.insert none (Set.Finite.image some
    ((Ideal.finite_factors hnum).union (Ideal.finite_factors hden))))
    (support_log_pointAbv_subset f)

/-- The weighted logarithmic integrand is supported where the logarithmic integrand is. -/
theorem support_weighted_log_subset (f : RatFunc k) :
    (Function.support fun ω ↦ (pointWeight k ω).toReal * Real.log (pointAbv k ω f)) ⊆
      Function.support fun ω ↦ Real.log (pointAbv k ω f) := fun ω hω ↦ by
  simp only [Function.mem_support] at hω ⊢
  intro hzero
  exact hω (by rw [hzero, mul_zero])

/-- For nonzero `f`, the weighted logarithmic integrand of `f` has finite support. -/
theorem finite_support_weighted_log {f : RatFunc k} (hf : f ≠ 0) :
    (Function.support fun ω ↦ (pointWeight k ω).toReal * Real.log (pointAbv k ω f)).Finite :=
  (finite_support_log hf).subset (support_weighted_log_subset f)

/-- The weighted logarithmic finsum is additive under multiplication. -/
theorem finsum_weighted_log_mul {f g : RatFunc k} (hf : f ≠ 0) (hg : g ≠ 0) :
    (∑ᶠ ω, (pointWeight k ω).toReal * Real.log (pointAbv k ω (f * g))) =
      (∑ᶠ ω, (pointWeight k ω).toReal * Real.log (pointAbv k ω f)) +
        ∑ᶠ ω, (pointWeight k ω).toReal * Real.log (pointAbv k ω g) := by
  rw [← finsum_add_distrib (finite_support_weighted_log hf) (finite_support_weighted_log hg)]
  exact finsum_congr fun ω ↦ by
    rw [map_mul, Real.log_mul ((pointAbv k ω).ne_zero hf) ((pointAbv k ω).ne_zero hg),
      mul_add]

/-- The product formula for nonzero constants. -/
theorem finsum_weighted_log_C {c : k} (hc : c ≠ 0) :
    (∑ᶠ ω, (pointWeight k ω).toReal *
      Real.log (pointAbv k ω (algebraMap (Polynomial k) (RatFunc k) (Polynomial.C c)))) = 0 := by
  have hzero : ∀ ω, Real.log (pointAbv k ω
      (algebraMap (Polynomial k) (RatFunc k) (Polynomial.C c))) = 0 := by
    rintro (_ | v)
    · rw [pointAbv_none, real_log_inftyAbv_algebraMap (Polynomial.C_ne_zero.mpr hc),
        Polynomial.natDegree_C, Nat.cast_zero]
    · rw [pointAbv_some, real_log_adicAbv v
        (RatFunc.algebraMap_ne_zero (Polynomial.C_ne_zero.mpr hc)),
        valuation_algebraMap_C v hc, log_one, Int.cast_zero]
  simp only [hzero, mul_zero]
  exact finsum_zero

/-- The product formula for prime polynomials: the pole of order `deg q` at infinity balances
the zero at the point cut out by `q`, which has residue degree `deg q`. -/
theorem finsum_weighted_log_prime {q : Polynomial k} (hq : Prime q) :
    (∑ᶠ ω, (pointWeight k ω).toReal *
      Real.log (pointAbv k ω (algebraMap (Polynomial k) (RatFunc k) q))) = 0 := by
  classical
  have hq0 : algebraMap (Polynomial k) (RatFunc k) q ≠ 0 :=
    RatFunc.algebraMap_ne_zero hq.ne_zero
  rw [finsum_eq_sum_of_support_subset _ (s := {some (spanPrime hq), none}) ?_]
  · rw [Finset.sum_pair (by simp)]
    rw [pointWeight_some, pointAbv_some, pointWeight_none, pointAbv_none,
      real_log_adicAbv _ hq0, valuation_spanPrime_self hq, log_exp,
      real_log_inftyAbv_algebraMap hq.ne_zero, pointDegree_spanPrime hq,
      ENNReal.toReal_natCast, ENNReal.toReal_one, one_mul]
    push_cast
    ring
  · rintro (_ | v) hω
    · simp
    · simp only [Finset.coe_insert, Finset.coe_singleton, Set.mem_insert_iff,
        Set.mem_singleton_iff]
      left
      by_contra hv
      have hvne : v ≠ spanPrime hq := fun h ↦ hv (by rw [h])
      simp only [Function.mem_support] at hω
      exact hω (by rw [pointAbv_some, real_log_adicAbv v hq0,
        valuation_algebraMap_eq_one_of_ne hq hvne, log_one, Int.cast_zero, mul_zero])

/-- The product formula for nonzero polynomials, by induction on prime factorizations. -/
theorem finsum_weighted_log_polynomial :
    ∀ {p : Polynomial k}, p ≠ 0 →
      (∑ᶠ ω, (pointWeight k ω).toReal *
        Real.log (pointAbv k ω (algebraMap (Polynomial k) (RatFunc k) p))) = 0 := by
  intro p
  induction p using UniqueFactorizationMonoid.induction_on_prime with
  | h₁ => exact fun h ↦ absurd rfl h
  | h₂ x hx =>
    intro _
    obtain ⟨c, hcu, rfl⟩ := Polynomial.isUnit_iff.mp hx
    exact finsum_weighted_log_C hcu.ne_zero
  | h₃ a q ha hq ih =>
    intro _
    rw [map_mul, finsum_weighted_log_mul (RatFunc.algebraMap_ne_zero hq.ne_zero)
      (RatFunc.algebraMap_ne_zero ha), finsum_weighted_log_prime hq, ih ha, add_zero]

/-- **The product formula** for `k(X)` (Chen–Moriwaki §3.2.1, properness of the
function-field adelic curve), in weighted-finsum form:
`∑_x n_x · log |f|_x = 0` over the closed points of `ℙ¹_k`. -/
theorem finsum_weighted_log_eq_zero {f : RatFunc k} (hf : f ≠ 0) :
    (∑ᶠ ω, (pointWeight k ω).toReal * Real.log (pointAbv k ω f)) = 0 := by
  have hkey : (∑ᶠ ω, (pointWeight k ω).toReal *
      Real.log (pointAbv k ω (algebraMap (Polynomial k) (RatFunc k) f.num))) =
        (∑ᶠ ω, (pointWeight k ω).toReal * Real.log (pointAbv k ω f)) +
          ∑ᶠ ω, (pointWeight k ω).toReal *
            Real.log (pointAbv k ω (algebraMap (Polynomial k) (RatFunc k) f.denom)) := by
    rw [algebraMap_num_eq_mul_denom f]
    exact finsum_weighted_log_mul hf (RatFunc.algebraMap_ne_zero f.denom_ne_zero)
  rw [finsum_weighted_log_polynomial (RatFunc.num_ne_zero hf),
    finsum_weighted_log_polynomial f.denom_ne_zero] at hkey
  linarith

end Points

/-! ### The adelic structure -/

/-- The adelic structure of the function field of `ℙ¹_k` (Chen–Moriwaki §3.2.1): the closed
points of `ℙ¹_k` with the discrete σ-algebra, each point `x` weighted by
`n_x = [κ(x) : k]` and carrying the absolute value `e^{-ord_x}`. -/
noncomputable def functionFieldAdelicStructure (k : Type*) [Field k] :
    AdelicStructure (RatFunc k) where
  Ω := Option (HeightOneSpectrum (Polynomial k))
  A := ⊤
  v := @Measure.ofSingletons _ ⊤ (pointWeight k)
  ϕ := pointAbv k
  measurable_log := fun _ _ ↦ measurable_from_top
  integrable_log := by
    intro f hf
    let : MeasurableSpace (Option (HeightOneSpectrum (Polynomial k))) := ⊤
    refine integrable_of_support_subset_finset
      (s := (finite_support_log hf).toFinset) ?_ fun x _ ↦ ?_
    · rw [Set.Finite.coe_toFinset]
    · rw [Measure.ofSingletons_singleton]
      exact pointWeight_ne_top x

/-- The product formula `∑_x n_x ord_x (f) = 0` of Chen–Moriwaki §3.2.1, integrated against
the point measure of the function-field adelic structure. -/
theorem functionField_product_formula {k : Type*} [Field k] {f : RatFunc k} (hf : f ≠ 0) :
    letI : MeasurableSpace (Option (HeightOneSpectrum (Polynomial k))) := ⊤
    ∫ ω, Real.log (pointAbv k ω f) ∂(Measure.ofSingletons (pointWeight k)) = 0 := by
  let : MeasurableSpace (Option (HeightOneSpectrum (Polynomial k))) := ⊤
  rw [integral_eq_sum_of_support_subset_finset (s := (finite_support_log hf).toFinset)
    (by rw [Set.Finite.coe_toFinset]) fun x _ ↦ by
      rw [Measure.ofSingletons_singleton]; exact pointWeight_ne_top x]
  rw [Finset.sum_congr rfl fun x _ ↦ by
    rw [Measure.ofSingletons_singleton, smul_eq_mul]]
  rw [← finsum_eq_sum_of_support_subset _ (by
    rw [Set.Finite.coe_toFinset]
    exact support_weighted_log_subset f)]
  exact finsum_weighted_log_eq_zero hf

/-- The function-field adelic structure is proper: this is the vanishing of the degree of
principal divisors on `ℙ¹_k`, i.e. the product formula of Chen–Moriwaki §3.2.1. -/
instance instIsProperFunctionFieldAdelicStructure (k : Type*) [Field k] :
    IsProper (functionFieldAdelicStructure k) := by
  constructor
  intro f hf
  exact functionField_product_formula hf

end ArakelovGeometry.AdelicStructure

namespace ArakelovGeometry.AdelicCurve

/-- The adelic curve of the function field `k(X)` of `ℙ¹_k` (Chen–Moriwaki §3.2.1). -/
noncomputable abbrev functionFieldAdelicCurve (k : Type*) [Field k] : AdelicCurve :=
  (AdelicStructure.functionFieldAdelicStructure k).toAdelicCurve

/-- The logarithmic product formula, exposed in the curve namespace for compatibility. -/
alias functionField_product_formula := AdelicStructure.functionField_product_formula

/-- Properness of the function-field adelic curve, inherited from its adelic structure. -/
abbrev instIsProperFunctionFieldAdelicCurve (k : Type*) [Field k] :
    IsProper (functionFieldAdelicCurve k) :=
  AdelicStructure.instIsProperFunctionFieldAdelicStructure k

end ArakelovGeometry.AdelicCurve
