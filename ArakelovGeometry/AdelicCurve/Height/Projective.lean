import ArakelovGeometry.AdelicCurve.Height.Affine
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic

/-!
# Fields of definition and normalized projective coordinates

The field of definition of a projective point is the intermediate field generated
by its coordinate ratios. It is independent of the representative and equals the
field generated by the coordinates in any affine chart. For finitely many
coordinates in an algebraic extension it is finite over the base field.

Reference: Chen–Moriwaki, the field `K(x)` in Theorem 3.5.3.
-/

namespace Projectivization

variable (K : Type*) {L ι : Type*} [Field K] [Field L] [Algebra K L]

/-- The field generated by all ratios of coordinates of a tuple. -/
noncomputable def coordinateField (a : ι → L) : IntermediateField K L :=
  IntermediateField.adjoin K (Set.range fun p : ι × ι ↦ a p.1 / a p.2)

theorem div_mem_coordinateField (a : ι → L) (i j : ι) :
    a i / a j ∈ coordinateField K a :=
  IntermediateField.subset_adjoin K _ ⟨(i, j), rfl⟩

theorem coordinateField_smul (a : ι → L) {t : L} (ht : t ≠ 0) :
    coordinateField K (t • a) = coordinateField K a := by
  simp only [coordinateField, Pi.smul_apply, smul_eq_mul, mul_div_mul_left _ _ ht]

/-- The intrinsic field of definition of a projective point, generated by coordinate ratios. -/
noncomputable def fieldOfDefinition (x : Projectivization L (ι → L)) :
    IntermediateField K L :=
  x.lift (fun a ↦ coordinateField K a.val) fun a b t h ↦ by
    have ht : t ≠ 0 := by
      intro ht
      exact a.property (by simpa [ht] using h)
    rw [h, coordinateField_smul K _ ht]

@[simp] theorem fieldOfDefinition_mk {a : ι → L} (ha : a ≠ 0) :
    fieldOfDefinition K (mk L a ha) = coordinateField K a := rfl

theorem fieldOfDefinition_eq (x : Projectivization L (ι → L)) :
    fieldOfDefinition K x = coordinateField K x.rep := by
  conv_lhs => rw [← x.mk_rep]
  rfl

theorem div_mem_fieldOfDefinition (x : Projectivization L (ι → L)) (i j : ι) :
    x.rep i / x.rep j ∈ fieldOfDefinition K x := by
  rw [fieldOfDefinition_eq]
  exact div_mem_coordinateField K _ i j

/-- A single nonzero coordinate suffices to generate the field of coordinate ratios. -/
theorem coordinateField_eq_adjoin (a : ι → L) {j : ι} (hj : a j ≠ 0) :
    coordinateField K a = IntermediateField.adjoin K (Set.range fun i ↦ a i / a j) := by
  apply le_antisymm
  · apply IntermediateField.adjoin_le_iff.mpr
    rintro _ ⟨⟨i, k⟩, rfl⟩
    change a i / a k ∈ IntermediateField.adjoin K (Set.range fun i ↦ a i / a j)
    rw [← div_div_div_cancel_right₀ hj (a i) (a k)]
    apply IntermediateField.div_mem
    · exact IntermediateField.subset_adjoin K _ ⟨i, rfl⟩
    · exact IntermediateField.subset_adjoin K _ ⟨k, rfl⟩
  · apply IntermediateField.adjoin_le_iff.mpr
    rintro _ ⟨i, rfl⟩
    exact div_mem_coordinateField K a i j

/-- Formula for the field of definition in any nonzero affine chart. -/
theorem fieldOfDefinition_eq_adjoin (x : Projectivization L (ι → L))
    {j : ι} (hj : x.rep j ≠ 0) :
    fieldOfDefinition K x =
      IntermediateField.adjoin K (Set.range fun i ↦ x.rep i / x.rep j) := by
  rw [fieldOfDefinition_eq, coordinateField_eq_adjoin K _ hj]

/-- The chart formula may be computed using any representative of the projective point. -/
theorem fieldOfDefinition_mk_eq_adjoin {a : ι → L} (ha : a ≠ 0)
    {j : ι} (hj : a j ≠ 0) :
    fieldOfDefinition K (mk L a ha) =
      IntermediateField.adjoin K (Set.range fun i ↦ a i / a j) := by
  rw [fieldOfDefinition_mk, coordinateField_eq_adjoin K a hj]

variable {K}

/-- The normalized coordinate tuple on a chosen projective chart. -/
noncomputable def normalizedCoordinates (x : Projectivization L (ι → L)) (j : ι) : ι → L :=
  fun i ↦ x.rep i / x.rep j

theorem normalizedCoordinates_self (x : Projectivization L (ι → L))
    {j : ι} (hj : x.rep j ≠ 0) : x.normalizedCoordinates j j = 1 :=
  div_self hj

theorem normalizedCoordinates_ne_zero (x : Projectivization L (ι → L))
    {j : ι} (hj : x.rep j ≠ 0) : x.normalizedCoordinates j ≠ 0 := by
  intro h
  have := congrFun h j
  rw [x.normalizedCoordinates_self hj] at this
  exact one_ne_zero this

/-- Normalizing by a nonzero coordinate preserves the projective point. -/
theorem mk_normalizedCoordinates (x : Projectivization L (ι → L))
    {j : ι} (hj : x.rep j ≠ 0) :
    mk L (x.normalizedCoordinates j) (x.normalizedCoordinates_ne_zero hj) = x := by
  calc
    _ = mk L x.rep x.rep_nonzero := by
      apply (mk_eq_mk_iff' L _ _ _ _).mpr
      refine ⟨(x.rep j)⁻¹, ?_⟩
      ext i
      simp [normalizedCoordinates, div_eq_mul_inv, mul_comm]
    _ = x := x.mk_rep

/-- Normalized coordinates determine the projective point uniquely. -/
theorem eq_of_normalizedCoordinates_eq {x y : Projectivization L (ι → L)} {j k : ι}
    (hj : x.rep j ≠ 0) (hk : y.rep k ≠ 0)
    (h : x.normalizedCoordinates j = y.normalizedCoordinates k) : x = y := by
  rw [← x.mk_normalizedCoordinates hj, ← y.mk_normalizedCoordinates hk]
  congr 1

variable (K)

/-- Minimality: a point is defined over exactly the fields containing its coordinate field. -/
theorem fieldOfDefinition_le_iff (x : Projectivization L (ι → L))
    (F : IntermediateField K L) : fieldOfDefinition K x ≤ F ↔
      ∃ (a : ι → L) (ha : a ≠ 0), mk L a ha = x ∧ ∀ i, a i ∈ F := by
  constructor
  · intro h
    obtain ⟨j, hj⟩ : ∃ j, x.rep j ≠ 0 := by
      by_contra! hzero
      exact x.rep_nonzero (funext hzero)
    refine ⟨x.normalizedCoordinates j, x.normalizedCoordinates_ne_zero hj,
      x.mk_normalizedCoordinates hj, ?_⟩
    exact fun i ↦ h (div_mem_fieldOfDefinition K x i j)
  · rintro ⟨a, ha, hax, hF⟩
    rw [← hax, fieldOfDefinition_mk]
    apply IntermediateField.adjoin_le_iff.mpr
    rintro _ ⟨⟨i, j⟩, rfl⟩
    exact F.div_mem (hF i) (hF j)

section Algebraic

variable [Finite ι] [Algebra.IsAlgebraic K L]

instance finiteDimensional_coordinateField (a : ι → L) :
    FiniteDimensional K (coordinateField K a) := by
  apply IntermediateField.finiteDimensional_adjoin
  exact fun z _ ↦ (Algebra.IsAlgebraic.isAlgebraic (R := K) z).isIntegral

instance finiteDimensional_fieldOfDefinition (x : Projectivization L (ι → L)) :
    FiniteDimensional K (fieldOfDefinition K x) := by
  rw [fieldOfDefinition_eq]
  infer_instance

end Algebraic

/-- Each normalized coordinate has degree at most the degree of the projective point. -/
theorem finrank_adjoin_div_le (x : Projectivization L (ι → L))
    [FiniteDimensional K (fieldOfDefinition K x)] (i j : ι) :
    Module.finrank K (IntermediateField.adjoin K {x.rep i / x.rep j}) ≤
      Module.finrank K (fieldOfDefinition K x) := by
  apply IntermediateField.finrank_le_of_le_right
  exact IntermediateField.adjoin_simple_le_iff.mpr (div_mem_fieldOfDefinition K x i j)

end Projectivization

namespace ArakelovGeometry.AdelicStructure

variable {L ι : Type*} [Field L] [Fintype ι] [Nonempty ι]
    (AS : AdelicStructure L) [AS.IsProper]

/-- Every coordinate in a nonzero projective chart has height bounded by the point's height. -/
theorem affineHeight_normalizedCoordinates_le (x : Projectivization L (ι → L))
    {j : ι} (hj : x.rep j ≠ 0) (i : ι) :
    AS.affineHeight (x.normalizedCoordinates j i) ≤ AS.projectiveHeight x := by
  have h := AS.affineHeight_div_le_logHeight x.rep hj i
  simpa only [Projectivization.normalizedCoordinates,
    ← AS.projectiveHeight_mk x.rep_nonzero, x.mk_rep] using h

end ArakelovGeometry.AdelicStructure
