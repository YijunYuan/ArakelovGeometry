/-!
# Binary special-linear orbit coordinates

The coordinate algebra of two determinant-one matrices gives an affine orbit
morphism. Polynomial orbit closure implies closure of its image.
The parameterization uses `h ↦ rhoDual (h⁻¹) f`; inversion is bijective, so its
image is the full orbit. Reducedness and closed-point density are not assumed.
-/

@[expose] public section
noncomputable section

open scoped TensorProduct
open MvPolynomial Matrix

namespace ArakelovGeometry.InvariantTheory

section CoordinateAlgebra

variable (k : Type*) [CommRing k] (ι : Bool → Type*)
  [∀ j, Fintype (ι j)] [∀ j, DecidableEq (ι j)]

/-- The matrix variables for the two actual SL factors; the row is listed first. -/
abbrev BinarySLVariables : Type _ := Σ j, ι j × ι j

/-- The two universal matrices before imposing determinant one. -/
def binarySLUniversalMatrix (j : Bool) :
    Matrix (ι j) (ι j) (MvPolynomial (BinarySLVariables ι) k) :=
  fun u v ↦ X ⟨j, u, v⟩

/-- The ideal generated by the two determinant-one equations. -/
def binarySLRelations : Ideal (MvPolynomial (BinarySLVariables ι) k) :=
  Ideal.span (Set.range fun j ↦ (binarySLUniversalMatrix k ι j).det - 1)

/-- The coordinate algebra of the binary special linear group, presented
by the determinant-one relations on the two matrices. -/
abbrev BinarySLCoordinateAlgebra : Type _ :=
  MvPolynomial (BinarySLVariables ι) k ⧸ binarySLRelations k ι

/-- The entries of the universal determinant-one matrices. -/
def binarySLCoordinate (j : Bool) (u v : ι j) : BinarySLCoordinateAlgebra k ι :=
  Ideal.Quotient.mk _ (X ⟨j, u, v⟩)

@[simp]
theorem binarySLCoordinate_det (j : Bool) :
    Matrix.det (fun u v ↦ binarySLCoordinate k ι j u v) = 1 := by
  let φ := Ideal.Quotient.mk (binarySLRelations k ι)
  have hz : φ ((binarySLUniversalMatrix k ι j).det - 1) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨j, rfl⟩)
  rw [map_sub, map_one, sub_eq_zero] at hz
  rw [← hz, RingHom.map_det]
  rfl

variable {k ι} {L : Type*} [CommRing L] [Algebra k L]

/-- Polynomial evaluation at the entries of actual determinant-one matrices. -/
def evalBinarySLPolynomial (h : ∀ j, Matrix.SpecialLinearGroup (ι j) L) :
    MvPolynomial (BinarySLVariables ι) k →ₐ[k] L :=
  aeval (fun v ↦ (h v.1).val v.2.1 v.2.2)

@[simp]
theorem evalBinarySLPolynomial_det (h : ∀ j, Matrix.SpecialLinearGroup (ι j) L)
    (j : Bool) : evalBinarySLPolynomial (k := k) h
      (binarySLUniversalMatrix k ι j).det = 1 := by
  rw [(evalBinarySLPolynomial (k := k) h).map_det]
  convert (h j).prop using 1
  congr 1
  ext u v
  exact aeval_X _ _

/-- Evaluate the quotient at an actual pair of determinant-one matrices. -/
def evalBinarySL (h : ∀ j, Matrix.SpecialLinearGroup (ι j) L) :
    BinarySLCoordinateAlgebra k ι →ₐ[k] L :=
  Ideal.Quotient.liftₐ _ (evalBinarySLPolynomial h) (by
    change binarySLRelations k ι ≤ RingHom.ker (evalBinarySLPolynomial h).toRingHom
    apply Ideal.span_le.mpr
    rintro _ ⟨j, rfl⟩
    change evalBinarySLPolynomial h ((binarySLUniversalMatrix k ι j).det - 1) = 0
    rw [map_sub, map_one, evalBinarySLPolynomial_det, sub_self])

@[simp]
theorem evalBinarySL_coordinate (h : ∀ j, Matrix.SpecialLinearGroup (ι j) L)
    (j : Bool) (u v : ι j) :
    evalBinarySL h (binarySLCoordinate k ι j u v) = h j u v := by
  change evalBinarySLPolynomial h (X ⟨j, u, v⟩) = _
  exact aeval_X _ _

/-- Every extension-algebra point produces actual determinant-one matrices. -/
def binarySLOfAlgHom (χ : BinarySLCoordinateAlgebra k ι →ₐ[k] L) :
    ∀ j, Matrix.SpecialLinearGroup (ι j) L := fun j ↦
  ⟨fun u v ↦ χ (binarySLCoordinate k ι j u v), by
    exact (χ.map_det (fun u v ↦ binarySLCoordinate k ι j u v)).symm.trans
      ((congrArg χ (binarySLCoordinate_det k ι j)).trans χ.map_one)⟩

@[simp]
theorem binarySLOfAlgHom_eval (h : ∀ j, Matrix.SpecialLinearGroup (ι j) L) :
    binarySLOfAlgHom (evalBinarySL (k := k) h) = h := by
  funext j
  apply Subtype.ext
  ext u v
  exact evalBinarySL_coordinate h j u v

@[simp]
theorem evalBinarySL_ofAlgHom (χ : BinarySLCoordinateAlgebra k ι →ₐ[k] L) :
    evalBinarySL (binarySLOfAlgHom χ) = χ := by
  apply Ideal.Quotient.algHom_ext k
  ext v
  exact evalBinarySL_coordinate (binarySLOfAlgHom χ) v.1 v.2.1 v.2.2

end CoordinateAlgebra

section TensorCoordinates

variable (k : Type*) [Field k] (ι : Bool → Type*)
  [∀ j, Fintype (ι j)] [∀ j, DecidableEq (ι j)] (r : ℕ)

/-- Standard basis indices of the actual binary tensor power. -/
abbrev BinaryTensorIndex : Type _ := Fin r → ∀ j, ι j

/-- The standard basis of the binary tensor power. -/
def binaryTensorBasis : Module.Basis (BinaryTensorIndex ι r) k
    (⨂[k]^r (⨂[k] j, (ι j → k))) :=
  Basis.piTensorProduct (fun _ : Fin r ↦
    Basis.piTensorProduct (fun j ↦ Pi.basisFun k (ι j)))

@[simp]
theorem binaryTensorBasis_apply (p : BinaryTensorIndex ι r) :
    binaryTensorBasis k ι r p = (⨂ₜ[k] l, (⨂ₜ[k] j, Pi.single (p l j) 1)) := by
  simp [binaryTensorBasis, Pi.basisFun_apply]

omit [∀ j, DecidableEq (ι j)] in
@[simp]
theorem binaryTensorBasis_repr_tprod (x : Fin r → ∀ j, ι j → k)
    (p : BinaryTensorIndex ι r) :
    (binaryTensorBasis k ι r).repr (⨂ₜ[k] l, (⨂ₜ[k] j, x l j)) p =
      ∏ l, ∏ j, x l j (p l j) := by
  simp [binaryTensorBasis]

omit [∀ j, DecidableEq (ι j)] in
/-- Pure-tensor evaluation expressed in the standard basis, allowing
basis integrality to extend to all integral pure tensors. -/
theorem binaryCovector_eval_tprod
    (f : Module.Dual k (⨂[k]^r (⨂[k] j, (ι j → k))))
    (x : Fin r → ∀ j, ι j → k) :
    f (⨂ₜ[k] l, (⨂ₜ[k] j, x l j)) =
      ∑ p, f (binaryTensorBasis k ι r p) * (∏ l, ∏ j, x l j (p l j)) := by
  classical
  have h := congrArg f ((binaryTensorBasis k ι r).sum_repr
    (⨂ₜ[k] l, (⨂ₜ[k] j, x l j)))
  simpa only [map_sum, map_smul, binaryTensorBasis_repr_tprod, smul_eq_mul,
    mul_comm] using h.symm

variable {k ι r} (L : Type*) [Field L] [Algebra k L]

/-- Coefficient scalar extension in the standard tensor basis, defining
a covector on the tensor power over `L`. -/
def binaryCovectorBaseChange (f : Module.Dual k (⨂[k]^r (⨂[k] j, (ι j → k)))) :
    Module.Dual L (⨂[L]^r (⨂[L] j, (ι j → L))) :=
  (binaryTensorBasis L ι r).constr L
    (fun p ↦ algebraMap k L (f (binaryTensorBasis k ι r p)))

omit [∀ j, DecidableEq (ι j)] in
@[simp]
theorem binaryCovectorBaseChange_basis
    (f : Module.Dual k (⨂[k]^r (⨂[k] j, (ι j → k)))) (p : BinaryTensorIndex ι r) :
    binaryCovectorBaseChange L f (binaryTensorBasis L ι r p) =
      algebraMap k L (f (binaryTensorBasis k ι r p)) :=
  (binaryTensorBasis L ι r).constr_basis L _ p

omit [∀ j, DecidableEq (ι j)] in
@[simp]
theorem binaryCovectorBaseChange_self
    (f : Module.Dual k (⨂[k]^r (⨂[k] j, (ι j → k)))) :
    binaryCovectorBaseChange k f = f := by
  apply (binaryTensorBasis k ι r).ext
  intro p
  exact binaryCovectorBaseChange_basis k f p

variable {L}

/-- The explicit polynomial orbit pullback. It parameterizes `h⁻¹` in the dual
representation: output matrix indices are rows. Inversion gives exactly the same
actual orbit, rather than a weaker set of degeneration tests. -/
def binaryCovectorOrbitPullback
    (f : Module.Dual k (⨂[k]^r (⨂[k] j, (ι j → k)))) :
    MvPolynomial (BinaryTensorIndex ι r) k →ₐ[k] BinarySLCoordinateAlgebra k ι :=
  aeval fun p ↦ ∑ s, algebraMap k _ (f (binaryTensorBasis k ι r s)) *
    (∏ l, ∏ j, binarySLCoordinate k ι j (s l j) (p l j))

/-- Contragredient evaluation at an inverse matrix point, over every
extension field. -/
theorem binaryCovector_dual_inverse_eval
    (f : Module.Dual L (⨂[L]^r (⨂[L] j, (ι j → L))))
    (h : ∀ j, Matrix.SpecialLinearGroup (ι j) L) (p : BinaryTensorIndex ι r) :
    (tensorPowerRepresentation r
      (tensorSLRepresentation (k := L) (fun j ↦ ι j → L))).dual
      (fun j ↦ Matrix.SpecialLinearGroup.toLin'_equiv ((h j)⁻¹)) f
      (binaryTensorBasis L ι r p) =
    ∑ s, f (binaryTensorBasis L ι r s) * (∏ l, ∏ j, h j (s l j) (p l j)) := by
  change f (PiTensorProduct.map (fun _ : Fin r ↦
    tensorSLRepresentation (k := L) (fun j ↦ ι j → L)
      ((fun j ↦ Matrix.SpecialLinearGroup.toLin'_equiv ((h j)⁻¹))⁻¹)) _) = _
  rw [binaryTensorBasis_apply, PiTensorProduct.map_tprod]
  change f (⨂ₜ[L] l, PiTensorProduct.map (fun j ↦
    ((Matrix.SpecialLinearGroup.toLin'_equiv ((h j)⁻¹))⁻¹).val.toLinearMap)
      (⨂ₜ[L] j, Pi.single (p l j) 1)) = _
  simp only [← map_inv, inv_inv, PiTensorProduct.map_tprod]
  have hm (j : Bool) (v : ι j) :
      (Matrix.SpecialLinearGroup.toLin'_equiv (h j)).val (Pi.single v 1) =
        fun u ↦ h j u v := by
    change (h j).val *ᵥ Pi.single v 1 = _
    ext u
    simp [Matrix.mulVec, dotProduct, Pi.single_apply]
  simp_rw [LinearEquiv.coe_coe, hm]
  exact binaryCovector_eval_tprod L ι r f _

/-- The orbit-coordinate polynomial agrees with the actual dual tensor action
at every extension-field point of the actual binary SL group. -/
theorem binaryCovectorOrbitPullback_eval
    (f : Module.Dual k (⨂[k]^r (⨂[k] j, (ι j → k))))
    (h : ∀ j, Matrix.SpecialLinearGroup (ι j) L) (p : BinaryTensorIndex ι r) :
    evalBinarySL h (binaryCovectorOrbitPullback f (X p)) =
      (tensorPowerRepresentation r
        (tensorSLRepresentation (k := L) (fun j ↦ ι j → L))).dual
        (fun j ↦ Matrix.SpecialLinearGroup.toLin'_equiv ((h j)⁻¹))
        (binaryCovectorBaseChange L f) (binaryTensorBasis L ι r p) := by
  rw [binaryCovector_dual_inverse_eval]
  simp only [binaryCovectorOrbitPullback, aeval_X, map_sum, map_mul, map_prod,
    AlgHom.commutes, evalBinarySL_coordinate, binaryCovectorBaseChange_basis]

/-- Polynomial evaluation on the entire actual orbit is the composite of the
orbit pullback and the group point, over any extension field. -/
theorem evalBinarySL_comp_orbitPullback
    (f : Module.Dual k (⨂[k]^r (⨂[k] j, (ι j → k))))
    (h : ∀ j, Matrix.SpecialLinearGroup (ι j) L) :
    (evalBinarySL h).comp (binaryCovectorOrbitPullback f) =
      aeval (fun p ↦ (tensorPowerRepresentation r
        (tensorSLRepresentation (k := L) (fun j ↦ ι j → L))).dual
        (fun j ↦ Matrix.SpecialLinearGroup.toLin'_equiv ((h j)⁻¹))
        (binaryCovectorBaseChange L f) (binaryTensorBasis L ι r p)) := by
  ext p
  simpa only [AlgHom.comp_apply, aeval_X] using binaryCovectorOrbitPullback_eval f h p

/-- The inverse matrix parameterization has the full orbit as its image,
including all module automorphisms in the special linear group. -/
theorem binaryCovector_inverse_orbit_image
    (f : Module.Dual L (⨂[L]^r (⨂[L] j, (ι j → L)))) :
    Set.range (fun h : ∀ j, Matrix.SpecialLinearGroup (ι j) L ↦
      (tensorPowerRepresentation r
        (tensorSLRepresentation (k := L) (fun j ↦ ι j → L))).dual
        (fun j ↦ Matrix.SpecialLinearGroup.toLin'_equiv ((h j)⁻¹)) f) =
    Set.range (fun g : ∀ j, _root_.SpecialLinearGroup L (ι j → L) ↦
      (tensorPowerRepresentation r
        (tensorSLRepresentation (k := L) (fun j ↦ ι j → L))).dual g f) := by
  apply Set.Subset.antisymm
  · rintro _ ⟨h, rfl⟩
    exact ⟨_, rfl⟩
  · rintro _ ⟨g, rfl⟩
    refine ⟨fun j ↦ (Matrix.SpecialLinearGroup.toLin'_equiv.symm (g j))⁻¹, ?_⟩
    simp only [inv_inv, MulEquiv.apply_symm_apply]

instance binarySLCoordinateAlgebra_finiteType : Algebra.FiniteType k
    (BinarySLCoordinateAlgebra k ι) :=
  Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ k (binarySLRelations k ι))
    (Ideal.Quotient.mkₐ_surjective k _)

/-- The actual binary orbit map is of finite type, directly from the finite
polynomial quotient presentation; no group reducedness is assumed. -/
theorem binaryCovectorOrbitPullback_finiteType
    (f : Module.Dual k (⨂[k]^r (⨂[k] j, (ι j → k)))) :
    (binaryCovectorOrbitPullback f).toRingHom.FiniteType := by
  apply RingHom.FiniteType.of_comp_finiteType (f := MvPolynomial.C)
  have he : (binaryCovectorOrbitPullback f).toRingHom.comp MvPolynomial.C =
      algebraMap k (BinarySLCoordinateAlgebra k ι) := by
    ext c
    exact (binaryCovectorOrbitPullback f).commutes c
  rw [he, RingHom.finiteType_algebraMap]
  infer_instance

/-- The origin as a prime ideal in the polynomial coordinate target. -/
def binaryOrbitOrigin : PrimeSpectrum (MvPolynomial (BinaryTensorIndex ι r) k) :=
  ⟨RingHom.ker (aeval (0 : BinaryTensorIndex ι r → k)).toRingHom, RingHom.ker_isPrime _⟩

/-- Polynomial orbit closure implies closure of the image of the affine
orbit morphism. The argument uses kernel containment without assuming
closed-point density or reducedness of the coordinate algebra. -/
theorem origin_mem_closure_specOrbit_of_actual_orbit_closure
    (f : Module.Dual k (⨂[k]^r (⨂[k] j, (ι j → k))))
    (hclosure : ∀ P : MvPolynomial (BinaryTensorIndex ι r) k,
      (∀ g : ∀ j, _root_.SpecialLinearGroup k (ι j → k),
        MvPolynomial.eval (fun p ↦ (tensorPowerRepresentation r
          (tensorSLRepresentation (k := k) (fun j ↦ ι j → k))).dual g f
          (binaryTensorBasis k ι r p)) P = 0) → MvPolynomial.eval 0 P = 0) :
    binaryOrbitOrigin (k := k) (ι := ι) (r := r) ∈
      closure (Set.range (PrimeSpectrum.comap (binaryCovectorOrbitPullback f).toRingHom)) := by
  rw [PrimeSpectrum.closure_range_comap]
  change RingHom.ker (binaryCovectorOrbitPullback f).toRingHom ≤
    RingHom.ker (aeval (0 : BinaryTensorIndex ι r → k)).toRingHom
  intro P hP
  change MvPolynomial.eval 0 P = 0
  apply hclosure P
  intro g
  let h : ∀ j, Matrix.SpecialLinearGroup (ι j) k :=
    fun j ↦ (Matrix.SpecialLinearGroup.toLin'_equiv.symm (g j))⁻¹
  have hz : evalBinarySL (k := k) h (binaryCovectorOrbitPullback f P) = 0 := by
    change binaryCovectorOrbitPullback f P = 0 at hP
    rw [hP, map_zero]
  have he := AlgHom.congr_fun (evalBinarySL_comp_orbitPullback f h) P
  simp only [AlgHom.comp_apply, h, inv_inv, MulEquiv.apply_symm_apply,
    binaryCovectorBaseChange_self] at he
  exact he.symm.trans hz

end TensorCoordinates

end ArakelovGeometry.InvariantTheory
