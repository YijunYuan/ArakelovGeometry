module

public import ArakelovGeometry.AdelicVectorBundle.HermitianBasis
public import ArakelovGeometry.NumberTheory.NumberFieldArchimedeanWeightedCovolume
public import Mathlib.NumberTheory.NumberField.Discriminant.Basic

/-!
# Covolume of the actual completed scalar integer lattice

The source lattice lives in the original completed tensor product. Its
canonical Euclidean measure is compared by an actual linear isometry to
Mathlib's Euclidean mixed space, then by the proved volume-preserving map
to the standard mixed product measure used in the discriminant formula.
-/

@[expose] public section

noncomputable section
open NumberField MeasureTheory
open scoped TensorProduct

namespace ArakelovGeometry.NumberFieldActualIntegerCovolume

open NumberFieldArchimedeanVectorDiagonal NumberFieldArchimedeanDiagonal
  NumberFieldArchimedeanEuclidean NumberFieldArchimedeanCovolume
  NumberFieldArchimedeanWeightedCovolume AdelicStructure NormFamily

variable (K : Type*) [Field K] [NumberField K]

/-- The original scalar basis generated by one. -/
abbrev scalarBasis : Module.Basis Unit K K := Module.Basis.singleton Unit K

/-- The actual Hermitian basis family of the original scalar line. -/
abbrev scalarFamily : NormFamily (normalizedNumberFieldAdelicStructure K) K :=
  ofBasisHermitian _ _ (scalarBasis K)

theorem scalarFamily_hermitian :
    (scalarFamily K).IsHermitian normalizedNumberFieldArchimedeanCompletions :=
  ofBasisHermitian_isHermitian (scalarBasis K) normalizedNumberFieldArchimedeanCompletions

/-- Actual scalar coordinates in the original completed tensor fibres. -/
def scalarCoordinates : CompletedVectorProduct K K ≃ₗ[ℝ] CompletedScalarProduct K :=
  LinearEquiv.piCongrRight (fun w =>
    LinearEquiv.restrictScalars ℝ
      (((scalarBasis K).baseChange (CompletedCoefficient w)).equivFun.trans
        (LinearEquiv.funUnique Unit (CompletedCoefficient w) (CompletedCoefficient w))))

theorem scalarCoordinates_diagonal (a : K) :
    scalarCoordinates K (vectorDiagonalMap (K := K) a) =
      algebraMap K (CompletedScalarProduct K) a := by
  ext w
  change ((scalarBasis K).baseChange (CompletedCoefficient w)).equivFun
    (1 ⊗ₜ[K] a) () = algebraMap K (CompletedCoefficient w) a
  rw [basis_equivFun_one_tmul]
  simp [scalarBasis, Module.Basis.singleton_repr]

theorem scalarFamily_norm (w : InfinitePlace K) (z : CompletedCoefficient w ⊗[K] K) :
    (scalarFamily K).norm (normalizedInfinitePlacePoint w) z =
      ‖((scalarBasis K).baseChange (CompletedCoefficient w)).equivFun z ()‖ := by
  rw [ofBasisHermitian_norm_of_infinite _ _ (normalizedInfinitePlacePoint_mem_inf w)]
  simp only [Fintype.sum_unique, Real.sqrt_sq (_root_.norm_nonneg _)]

/-- Coordinates to the usual mixed product, with the original real action. -/
def scalarMixedEquiv : CompletedVectorProduct K K ≃ₗ[ℝ] mixedEmbedding.mixedSpace K :=
  (scalarCoordinates K).trans coefficientMixedAlgEquiv.toLinearEquiv

theorem scalarMixedEquiv_diagonal (a : K) :
    scalarMixedEquiv K (vectorDiagonalMap (K := K) a) = mixedEmbedding K a := by
  rw [scalarMixedEquiv, LinearEquiv.trans_apply, scalarCoordinates_diagonal]
  exact coefficientMixedAlgEquiv_algebraMap a

theorem scalarMixedEquiv_apply_real (z : CompletedVectorProduct K K)
    (w : {w : InfinitePlace K // w.IsReal}) :
    (scalarMixedEquiv K z).1 w =
      normalizedRealCompletionEquiv w.property (scalarCoordinates K z w.val) := rfl

theorem scalarMixedEquiv_apply_complex (z : CompletedVectorProduct K K)
    (w : {w : InfinitePlace K // w.IsComplex}) :
    (scalarMixedEquiv K z).2 w =
      normalizedComplexCompletionEquiv w.property (scalarCoordinates K z w.val) := rfl

/-- The same coordinates, with Mathlib's actual Euclidean mixed norm. -/
def scalarEuclideanEquiv :
    CompletedVectorProduct K K ≃ₗ[ℝ] mixedEmbedding.euclidean.mixedSpace K :=
  (scalarMixedEquiv K).trans (mixedEmbedding.euclidean.toMixed K).symm.toLinearEquiv

open scoped Classical in
theorem scalarEuclideanEquiv_norm_sq (z : CompletedVectorProduct K K) :
    letI := euclideanNormedAddCommGroup (scalarFamily K)
    ‖scalarEuclideanEquiv K z‖ ^ 2 = ‖z‖ ^ 2 := by
  classical
  let := euclideanNormedAddCommGroup (scalarFamily K)
  rw [euclidean_norm_sq]
  rw [WithLp.prod_norm_sq_eq_of_L2, PiLp.norm_sq_eq_of_L2, PiLp.norm_sq_eq_of_L2]
  change (∑ w : {w : InfinitePlace K // w.IsReal}, ‖(scalarMixedEquiv K z).1 w‖ ^ 2) +
      (∑ w : {w : InfinitePlace K // w.IsComplex}, ‖(scalarMixedEquiv K z).2 w‖ ^ 2) = _
  simp_rw [scalarMixedEquiv_apply_real, scalarMixedEquiv_apply_complex,
    norm_normalizedRealCompletionEquiv, norm_normalizedComplexCompletionEquiv,
    scalarFamily_norm]
  change (∑ w : {w : InfinitePlace K // w.IsReal}, ‖scalarCoordinates K z w.val‖ ^ 2) +
      (∑ w : {w : InfinitePlace K // w.IsComplex}, ‖scalarCoordinates K z w.val‖ ^ 2) =
        ∑ w : InfinitePlace K, ‖scalarCoordinates K z w‖ ^ 2
  have hc : (∑ w : {w : InfinitePlace K // w.IsComplex}, ‖scalarCoordinates K z w.val‖ ^ 2) =
      ∑ w : {w : InfinitePlace K // ¬w.IsReal}, ‖scalarCoordinates K z w.val‖ ^ 2 := by
    apply Fintype.sum_equiv
      (Equiv.subtypeEquivRight (fun _ => InfinitePlace.not_isReal_iff_isComplex)).symm
    intro w
    rfl
  rw [hc]
  exact Fintype.sum_subtype_add_sum_subtype (fun w : InfinitePlace K => w.IsReal)
    (fun w => ‖scalarCoordinates K z w‖ ^ 2)

open scoped Classical in
/-- The actual scalar isometry uses the canonical unweighted norm on the original tensors. -/
def scalarEuclideanIsometry :
    letI := euclideanNormedAddCommGroup (scalarFamily K)
    letI := euclideanNormedSpace (scalarFamily K)
    CompletedVectorProduct K K ≃ₗᵢ[ℝ] mixedEmbedding.euclidean.mixedSpace K := by
  let := euclideanNormedAddCommGroup (scalarFamily K)
  let := euclideanNormedSpace (scalarFamily K)
  exact { toLinearEquiv := scalarEuclideanEquiv K
          norm_map' := fun z => by
            have h := scalarEuclideanEquiv_norm_sq K z
            nlinarith [_root_.norm_nonneg (scalarEuclideanEquiv K z), _root_.norm_nonneg z] }

open scoped Classical in
/-- The actual coordinate map with its continuous Euclidean source topology. -/
def scalarMixedContinuousEquiv :
    letI := euclideanNormedAddCommGroup (scalarFamily K)
    letI := euclideanNormedSpace (scalarFamily K)
    CompletedVectorProduct K K ≃L[ℝ] mixedEmbedding.mixedSpace K := by
  let := euclideanNormedAddCommGroup (scalarFamily K)
  let := euclideanNormedSpace (scalarFamily K)
  exact (scalarEuclideanIsometry K).toContinuousLinearEquiv.trans
    (mixedEmbedding.euclidean.toMixed K)

theorem scalarMixedContinuousEquiv_apply (z : CompletedVectorProduct K K) :
    scalarMixedContinuousEquiv K z = scalarMixedEquiv K z := by
  change mixedEmbedding.euclidean.toMixed K
    ((mixedEmbedding.euclidean.toMixed K).symm (scalarMixedEquiv K z)) = _
  exact (mixedEmbedding.euclidean.toMixed K).apply_symm_apply _

open scoped Classical in
theorem scalarMixed_measurePreserving :
    letI := euclideanNormedAddCommGroup (scalarFamily K)
    letI := euclideanNormedSpace (scalarFamily K)
    letI := euclideanInnerProduct (scalarFamily_hermitian K)
    letI : MeasurableSpace (CompletedVectorProduct K K) := borel _
    letI : BorelSpace (CompletedVectorProduct K K) := ⟨rfl⟩
    letI := measureSpaceOfInnerProductSpace (E := CompletedVectorProduct K K)
    MeasurePreserving (scalarMixedContinuousEquiv K) volume volume := by
  let := euclideanNormedAddCommGroup (scalarFamily K)
  let := euclideanNormedSpace (scalarFamily K)
  let := euclideanInnerProduct (scalarFamily_hermitian K)
  let : MeasurableSpace (CompletedVectorProduct K K) := borel _
  let : BorelSpace (CompletedVectorProduct K K) := ⟨rfl⟩
  let := measureSpaceOfInnerProductSpace (E := CompletedVectorProduct K K)
  exact (mixedEmbedding.euclidean.volumePreserving_toMixed K).comp
    (scalarEuclideanIsometry K).measurePreserving

/-- The ring of integers as an original integral submodule of the scalar field. -/
def integerModule : Submodule (𝓞 K) K := Submodule.span (𝓞 K) {1}

omit [NumberField K] in
theorem mem_integerModule (a : K) :
    a ∈ integerModule K ↔ ∃ b : 𝓞 K, (b : K) = a := by
  rw [integerModule, Submodule.mem_span_singleton]
  change (∃ b : 𝓞 K, (b : K) * 1 = a) ↔ _
  simp only [mul_one]

omit [NumberField K] in
theorem integerModule_fg : (integerModule K).FG := Submodule.fg_span_singleton 1

omit [NumberField K] in
theorem integerModule_full : Submodule.span K (integerModule K : Set K) = ⊤ := by
  apply top_unique
  intro a _
  have h1 : (1 : K) ∈ integerModule K := (mem_integerModule K 1).2 ⟨1, rfl⟩
  have := (Submodule.span K (integerModule K : Set K)).smul_mem a
    (Submodule.subset_span h1)
  simpa only [smul_eq_mul, mul_one] using this

open scoped Classical in
theorem integerLattice_comap :
    letI := euclideanNormedAddCommGroup (scalarFamily K)
    letI := euclideanNormedSpace (scalarFamily K)
    ZLattice.comap ℝ (mixedEmbedding.integerLattice K)
      (scalarMixedContinuousEquiv K).toLinearMap =
        NumberFieldArchimedeanVectorDiagonal.diagonalLattice (integerModule K) := by
  let := euclideanNormedAddCommGroup (scalarFamily K)
  let := euclideanNormedSpace (scalarFamily K)
  ext z
  change (∃ a : 𝓞 K, mixedEmbedding K (a : K) = scalarMixedContinuousEquiv K z) ↔
    ∃ a : integerModule K, vectorDiagonalMap (K := K) (a : K) = z
  rw [scalarMixedContinuousEquiv_apply]
  constructor
  · rintro ⟨a, ha⟩
    refine ⟨⟨a, (mem_integerModule K a).2 ⟨a, rfl⟩⟩, ?_⟩
    apply (scalarMixedEquiv K).injective
    exact (scalarMixedEquiv_diagonal K a).trans ha
  · rintro ⟨a, ha⟩
    obtain ⟨b, hb⟩ := (mem_integerModule K a).1 a.property
    refine ⟨b, ?_⟩
    rw [hb, ← scalarMixedEquiv_diagonal, ha]

open scoped Classical in
theorem integerCovolume_eq_mixed :
    euclideanCovolume (scalarFamily K) (scalarFamily_hermitian K) (integerModule K) =
      ZLattice.covolume (mixedEmbedding.integerLattice K) volume := by
  let := euclideanNormedAddCommGroup (scalarFamily K)
  let := euclideanNormedSpace (scalarFamily K)
  let := euclideanInnerProduct (scalarFamily_hermitian K)
  let : MeasurableSpace (CompletedVectorProduct K K) := borel _
  let : BorelSpace (CompletedVectorProduct K K) := ⟨rfl⟩
  let := measureSpaceOfInnerProductSpace (E := CompletedVectorProduct K K)
  have h := ZLattice.covolume_comap (mixedEmbedding.integerLattice K) volume volume
    (scalarMixed_measurePreserving K)
  rw [integerLattice_comap] at h
  exact h

theorem integerCovolume :
    euclideanCovolume (scalarFamily K) (scalarFamily_hermitian K) (integerModule K) =
      (2⁻¹ : ℝ) ^ InfinitePlace.nrComplexPlaces K * Real.sqrt |(NumberField.discr K : ℝ)| := by
  rw [integerCovolume_eq_mixed, mixedEmbedding.covolume_integerLattice]

theorem integerCovolume_pos :
    0 < euclideanCovolume (scalarFamily K) (scalarFamily_hermitian K) (integerModule K) :=
  euclideanCovolume_pos _ _ _ (integerModule_fg K) (integerModule_full K)

theorem discriminant_abs_pos : 0 < |(NumberField.discr K : ℝ)| := by
  exact abs_pos.mpr (Int.cast_ne_zero.mpr (NumberField.discr_ne_zero K))

/-- The source exponential normalization, without introducing a replacement for `χ_K`. -/
theorem integerCovolume_eq_exp :
    euclideanCovolume (scalarFamily K) (scalarFamily_hermitian K) (integerModule K) =
      Real.exp (-(InfinitePlace.nrComplexPlaces K * Real.log 2 -
        Real.log |(NumberField.discr K : ℝ)| / 2)) := by
  have hd := discriminant_abs_pos K
  have hs : 0 < Real.sqrt |(NumberField.discr K : ℝ)| := Real.sqrt_pos.2 hd
  have hp : 0 < (2⁻¹ : ℝ) ^ InfinitePlace.nrComplexPlaces K := by positivity
  rw [integerCovolume, ← Real.exp_log (mul_pos hp hs)]
  congr 1
  rw [Real.log_mul (ne_of_gt hp) (ne_of_gt hs), Real.log_pow, Real.log_inv,
    Real.log_sqrt hd.le]
  ring

theorem weightedIntegerCovolume :
    weightedCovolume (scalarFamily K) (scalarFamily_hermitian K) (integerModule K) =
      Real.sqrt |(NumberField.discr K : ℝ)| := by
  rw [weightedCovolume_eq_mul _ _ _ (integerModule_fg K) (integerModule_full K)]
  simp only [Module.finrank_self, mul_one]
  change (2 : ℝ) ^ InfinitePlace.nrComplexPlaces K *
    euclideanCovolume (scalarFamily K) (scalarFamily_hermitian K) (integerModule K) = _
  rw [integerCovolume, ← mul_assoc, ← mul_pow]
  norm_num

end ArakelovGeometry.NumberFieldActualIntegerCovolume
