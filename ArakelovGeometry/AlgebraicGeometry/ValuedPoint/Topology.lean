module

public import ArakelovGeometry.AlgebraicGeometry.ValuedPoint.BaseChange
import Mathlib.Combinatorics.Matroid.Init
import Mathlib.MeasureTheory.Integral.Bochner.Basic

/-!
# The evaluation topology on intrinsic valued points

The analytic topology is generated by analytic Zariski opens and inverse images
of real open sets under absolute-value evaluations of local regular functions.
Restriction along a scheme morphism is continuous; finite valued base change
therefore gives a continuous surjection on the specified analytic fibres.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace

noncomputable section

namespace ArakelovGeometry.ValuedPoint

universe u

variable {X Y : Scheme.{u}}

/-- A local regular-function evaluation lying in a subset of the real line. -/
def evalPreimage (U : X.Opens) (s : Γ(X, U)) (V : Set ℝ) : Set (ValuedPoint X) :=
  {x | ∃ hx : x.point ∈ U, x.eval U hx s ∈ V}

/-- The usual analytic subbasis: Zariski opens and local evaluations. -/
inductive Subbasic (X : Scheme.{u}) : Set (ValuedPoint X) → Prop
  | zariski (U : X.Opens) : Subbasic X {x | x.point ∈ U}
  | evaluation (U : X.Opens) (s : Γ(X, U)) (V : Set ℝ) (hV : IsOpen V) :
      Subbasic X (evalPreimage U s V)

/-- The topology generated by actual local regular-function evaluations. -/
instance (X : Scheme.{u}) : TopologicalSpace (ValuedPoint X) :=
  TopologicalSpace.generateFrom {s | Subbasic X s}

theorem isOpen_zariski (U : X.Opens) : IsOpen {x : ValuedPoint X | x.point ∈ U} :=
  isOpen_generateFrom_of_mem (Subbasic.zariski U)

theorem isOpen_evalPreimage (U : X.Opens) (s : Γ(X, U)) (V : Set ℝ) (hV : IsOpen V) :
    IsOpen (evalPreimage U s V) :=
  isOpen_generateFrom_of_mem (Subbasic.evaluation U s V hV)

theorem preimage_evalPreimage (f : X ⟶ Y) (U : Y.Opens) (s : Γ(Y, U)) (V : Set ℝ) :
    map f ⁻¹' evalPreimage U s V = evalPreimage (f ⁻¹ᵁ U) (f.app U s) V := by
  ext x
  change (∃ hx : f x.point ∈ U, (x.map f).eval U hx s ∈ V) ↔
    ∃ hx : f x.point ∈ U, x.eval (f ⁻¹ᵁ U) hx (f.app U s) ∈ V
  simp_rw [eval_map]

/-- Restriction along a scheme morphism is continuous in the evaluation topology. -/
theorem continuous_map (f : X ⟶ Y) : Continuous (map f) := by
  apply continuous_generateFrom_iff.mpr
  intro s hs
  cases hs with
  | zariski U => exact isOpen_zariski (f ⁻¹ᵁ U)
  | evaluation U s V hV =>
    rw [preimage_evalPreimage]
    exact isOpen_evalPreimage (f ⁻¹ᵁ U) (f.app U s) V hV

/-- Evaluation of a regular function is continuous on its actual open domain. -/
theorem continuous_eval (U : X.Opens) (s : Γ(X, U)) :
    Continuous (fun x : {x : ValuedPoint X // x.point ∈ U} ↦ x.1.eval U x.2 s) := by
  apply continuous_def.mpr
  intro V hV
  have h := (isOpen_evalPreimage U s V hV).preimage
    (continuous_subtype_val : Continuous (Subtype.val : {x : ValuedPoint X // x.point ∈ U} → _))
  convert h using 1
  ext x
  exact ⟨fun hx ↦ ⟨x.2, hx⟩, fun ⟨_, hx⟩ ↦ hx⟩

/-- Finite-valued-base-change projection is continuous on the actual analytic fibres. -/
theorem continuous_baseChangeMap {k L : Type u} [Field k] [Field L] [Algebra k L]
    (v : AbsoluteValue k ℝ) (vL : AbsoluteValue L ℝ) (hL : vL.under k = v)
    (f : X ⟶ Spec (CommRingCat.of k)) :
    Continuous (baseChangeMap v vL hL f) :=
  ((continuous_map _).comp continuous_subtype_val).subtype_mk _

theorem continuous_surjective_baseChangeMap {k L : Type u} [Field k] [Field L]
    [Algebra k L] [FiniteDimensional k L] (v : AbsoluteValue k ℝ)
    [CompleteSpace (WithAbs v)] (vL : AbsoluteValue L ℝ) (hL : vL.under k = v)
    (f : X ⟶ Spec (CommRingCat.of k)) :
    Continuous (baseChangeMap v vL hL f) ∧
      Function.Surjective (baseChangeMap v vL hL f) :=
  ⟨continuous_baseChangeMap v vL hL f, baseChangeMap_surjective v vL hL f⟩

end ArakelovGeometry.ValuedPoint
